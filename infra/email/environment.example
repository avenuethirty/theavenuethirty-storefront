NODE_ENV=development
EMAIL_SERVICE_DEVELOPMENT_TARGET_CONFIRMED=true
NOTIFICATIONS_ENABLED=false
COMMERCE_NOTIFY_DATABASE_URL=REPLACE_WITH_PRIVATE_RESTRICTED_WORKER_URL
# Mount the Supabase CA as a Render secret file, then use its absolute path.
COMMERCE_DATABASE_CA_FILE=/etc/secrets/supabase-ca.crt
COMMERCE_ALLOW_UNVERIFIED_TLS=false
RESEND_API_KEY=REPLACE_PRIVATELY
RESEND_WEBHOOK_SECRET=REPLACE_WITH_ENDPOINT_SIGNING_SECRET
NOTIFICATIONS_TEST_RECIPIENT=orders@theavenuethirty.com
