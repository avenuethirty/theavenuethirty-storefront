# Set these on the Directus Render service, not in the public storefront bundle.
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=<private Resend API key>
EMAIL_FROM=orders@mail.theavenuethirty.com
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_IGNORE_TLS=false
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
