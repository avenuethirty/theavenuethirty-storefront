# Keep private values unprefixed. Never commit .env.
DIRECTUS_URL=https://admin.example.com
DIRECTUS_RUNTIME_TOKEN=
# Used only by administrative schema tooling, never the storefront.
DIRECTUS_STATIC_TOKEN=
# Existing NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT is accepted server-side during setup.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRIVATE_KEY=
CATALOGUE_SOURCE=directus
# Explicit local-only fixtures: CATALOGUE_SOURCE=fixtures
SUPPLIER_APPLICATIONS_ENABLED=false
# Separate scoped server credential for private supplier submissions, never the catalogue reader.
DIRECTUS_SUPPLIER_TOKEN=
# Server-only Postgres connection for atomic commerce operations; never prefix with VITE_ or NEXT_PUBLIC_.
COMMERCE_DATABASE_URL=

# Explicit local development exception only. Rejected in production.
COMMERCE_ALLOW_UNVERIFIED_TLS=false
COMMERCE_DATABASE_CA_FILE=

# Development commerce only. Restricted account is generated by provisioning.
COMMERCE_DEVELOPMENT_ENABLED=false
COMMERCE_RUNTIME_DATABASE_URL=
COMMERCE_RECEIPT_SECRET=
DIRECTUS_STAFF_TOKEN=

# Approved Resend email and Directus Render administration, server-only.
RESEND_API_KEY=
RENDER_API_KEY=
RENDER_SERVICE_ID=

COMMERCE_NOTIFY_DATABASE_URL=
NOTIFICATIONS_ENABLED=false

# Standalone development email service. Sender activation stays explicit.
EMAIL_SERVICE_DEVELOPMENT_TARGET_CONFIRMED=false
RESEND_WEBHOOK_SECRET=
NOTIFICATIONS_TEST_RECIPIENT=
